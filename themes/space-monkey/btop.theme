theme[main_bg]="#1c0e00"     # Default background for terminals and themed UI surfaces"
theme[main_fg]="#e7aa5a"     # Primary text color used across Omarchy templates"
theme[title]="#e7aa5a"     # Primary text color used across Omarchy templates"
theme[hi_fg]="#BD4924" #DF782D # Omarchy UI accent: links, focused controls, active states // obsidian checkbox /  btop bottom left border & shortcuts"
theme[selected_bg]="#948a8b"  # base03 - Dim text, inactive UI, subtle borders // Obsidian icons, titles & interior borders / terminal dashes / fastfetch 3x box borders / btop cpu meter, top right border, left interior borders, processes bottom gradient, download border"
theme[selected_fg]="#BD4924" #DF782D # Omarchy UI accent: links, focused controls, active states // obsidian checkbox /  btop bottom left border & shortcuts"
theme[inactive_fg]="#948a8b"  # base03 - Dim text, inactive UI, subtle borders // Obsidian icons, titles & interior borders / terminal dashes / fastfetch 3x box borders / btop cpu meter, top right border, left interior borders, processes bottom gradient, download border"
theme[graph_text]="#e7aa5a"     # Primary text color used across Omarchy templates"
theme[meter_bg]="#948a8b"  # base03 - Dim text, inactive UI, subtle borders // Obsidian icons, titles & interior borders / terminal dashes / fastfetch 3x box borders / btop cpu meter, top right border, left interior borders, processes bottom gradient, download border"
theme[proc_misc]="#e7aa5a"     # Primary text color used across Omarchy templates"
theme[cpu_box]="#a8a9eb"  # base0E - Secondary accent (special highlights) // Terminal image files / btop top border / fastfetch bottom icons"
theme[mem_box]="#DF782D"  # base0B - Success/positive accents (ok, added, confirm) // Terminal executible, size & pdf files / obsidian H2 / Fastfetch logo & hardware icons / btop middle border"
theme[net_box]="#fd6883"  # base08 - Error/critical accents (alerts, destructive states) // Terminal writable / obsidian H1 / btop bottom left border / compressed files"
