background-color={{ background }}
text-color={{ foreground }}
border-color={{ accent }}
border-size=2
border-radius=6
default-timeout=10000
width=400
height=300
padding=12
horizontal-padding=12
font=JetBrainsMono Nerd Font 10
markup=1
format=<b>%s</b>\n%b
icons=1
max-icon-size=64
layer=overlay
anchor=top-right
margin=10,50
group-by=app-name
sort=+time

[urgency=low]
background-color={{ background }}
text-color={{ foreground }}
border-color={{ color3 }}

[urgency=normal]
background-color={{ background }}
text-color={{ foreground }}
border-color={{ accent }}

[urgency=high]
background-color={{ color1 }}
text-color={{ foreground }}
border-color={{ color1 }}
